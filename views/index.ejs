<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="stylesheet" href="/style.css">
  <title>Resource Library</title>
</head>
<body>
  <header>
    <h1>Jitha's Library</h1>
    <nav>
      <a href="/">Home</a>
      <a href="/browse">Browse</a>
      <a href="/resources">Resources</a>
      <a href="/account">Account</a>
      <a href="/login">Login</a>
      <a href="/register">Register</a>
    </nav>
  </header>

  <main>
    <section>
      <h2>About Us</h2>
      <p>
        The Resource Library is your one-stop solution for discovering and managing valuable educational content. 
        Whether you’re looking for articles, books, or videos, we’ve got you covered. Join us today and explore a world of resources at your fingertips.
      </p>
    </section>

    <section>
      <h2>Features</h2>
      <div class="features-grid">
        <div class="feature-card">
          <h3>Browse Resources</h3>
          <p>
            Explore a vast collection of resources, including articles, books, and videos, carefully curated to meet your needs.
          </p>
        </div>
        <div class="feature-card">
          <h3>Manage Your Account</h3>
          <p>
            Create an account to track your favorite resources, save them for later, and manage your preferences effortlessly.
          </p>
        </div>
        <div class="feature-card">
          <h3>Contribute</h3>
          <p>
            Have something valuable to share? Add your resources to the library and help others learn and grow.
          </p>
        </div>
      </div>
    </section>

    <section>
      <h2>Get Started</h2>
      <p>
        Ready to dive in? <a href="/browse">Start browsing</a> or <a href="/register">create an account</a> to access all features.
      </p>
    </section>
  </main>

  
</body>
</html>
